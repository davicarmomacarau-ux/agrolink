[
  {
    "name": "Product",
    "type": "object",
    "properties": {
      "title": { "type": "string", "description": "Título do anúncio" },
      "description": { "type": "string", "description": "Descrição detalhada do produto" },
      "category": {
        "type": "string",
        "enum": ["graos", "frutas", "hortalicas", "animais", "maquinas", "insumos", "sementes", "outros"],
        "description": "Categoria do produto"
      },
      "price": { "type": "number", "description": "Preço do produto" },
      "unit": {
        "type": "string",
        "enum": ["unidade", "kg", "tonelada", "saca", "litro", "cabeca", "hectare"],
        "description": "Unidade de medida"
      },
      "quantity": { "type": "number", "description": "Quantidade disponível" },
      "location": { "type": "string", "description": "Localização (cidade/estado)" },
      "images": { "type": "array", "items": { "type": "string" }, "description": "URLs das imagens do produto" },
      "seller_name": { "type": "string", "description": "Nome do vendedor" },
      "seller_phone": { "type": "string", "description": "Telefone do vendedor" },
      "seller_email": { "type": "string", "description": "Email do vendedor" },
      "status": {
        "type": "string",
        "enum": ["ativo", "vendido", "pausado"],
        "default": "ativo",
        "description": "Status do anúncio"
      }
    },
    "required": ["title", "category", "price", "unit", "quantity", "location"]
  },
  {
    "name": "Sale",
    "type": "object",
    "properties": {
      "product_id": { "type": "string", "description": "ID do produto vendido" },
      "product_title": { "type": "string", "description": "Título do produto" },
      "quantity": { "type": "number", "description": "Quantidade vendida" },
      "unit_price": { "type": "number", "description": "Preço unitário" },
      "total_amount": { "type": "number", "description": "Valor total da venda" },
      "platform_fee": { "type": "number", "description": "Taxa da plataforma (5%)" },
      "net_amount": { "type": "number", "description": "Valor líquido para o vendedor" },
      "seller_email": { "type": "string", "description": "Email do vendedor" },
      "buyer_name": { "type": "string", "description": "Nome do comprador" },
      "buyer_email": { "type": "string", "description": "Email do comprador" },
      "buyer_phone": { "type": "string", "description": "Telefone do comprador" },
      "status": {
        "type": "string",
        "enum": ["pendente", "confirmada", "entregue", "cancelada"],
        "default": "pendente",
        "description": "Status da venda"
      }
    },
    "required": ["product_id", "product_title", "quantity", "total_amount", "seller_email", "buyer_name"]
  }
]
